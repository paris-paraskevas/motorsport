      "raw": "<!-- wp:group {\"className\":\"pd-live\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group pd-live\"><!-- wp:paragraph -->\n<p><span hidden data-pd-now=\"2026-10-23T17:45:00Z\"></span><span class=\"pd-live-src\" data-pd-start=\"2026-10-23T17:30:00Z\" data-pd-end=\"2026-10-23T18:30:00Z\"></span><span class=\"pd-pill pd-pill-live\">● Live</span> <strong>Formula 1, Practice 1</strong> <span class=\"pd-mut\">· Austin · started <span class=\"pd-t\" data-utc=\"2026-10-23T17:30:00Z\" data-f=\"t\">17:30 UTC</span></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:cover {\"url\":\"https://paddock-tracker.com/wp-content/uploads/2026/10/83d8f-1920px-2025_singapore_gp_-_red_bull_-_max_verstappen_-_fp1.jpg\",\"dimRatio\":0,\"minHeight\":560,\"isDark\":true,\"align\":\"full\",\"className\":\"pd-hero\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-cover alignfull is-dark pd-hero\" style=\"min-height:560px\"><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"https://paddock-tracker.com/wp-content/uploads/2026/10/83d8f-1920px-2025_singapore_gp_-_red_bull_-_max_verstappen_-_fp1.jpg\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:paragraph {\"className\":\"pd-credit\"} -->\n<p class=\"pd-credit\">Stand-in photo: the Singapore race report’s own image (the site will show the circuit of the weekend)</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"pd-bignum\"} -->\n<p class=\"pd-bignum\" aria-hidden=\"true\">18</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"pd-chips\"} -->\n<p class=\"pd-chips\"><span class=\"pd-chip pd-s-f1\">Formula 1</span><span class=\"pd-chip pd-chip-info\">Round 18 of 23 · this weekend</span></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"pd-hero-title\"} -->\n<h1 class=\"wp-block-heading pd-hero-title\">United States Grand Prix</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"pd-hero-sub\"} -->\n<p class=\"pd-hero-sub\">At the Circuit of the Americas, Austin · 23–25 October</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"pd-count\"} -->\n<p class=\"pd-count\" data-pd-target=\"2026-10-23T21:00:00Z\"><span class=\"pd-cd-u\"><b data-pd-cd=\"a\">3</b><small data-pd-cdl=\"a\">hours</small></span><span class=\"pd-cd-u\"><b data-pd-cd=\"b\">15</b><small data-pd-cdl=\"b\">minutes</small></span><span class=\"pd-cd-to\">to <strong>Practice 2</strong> · <span class=\"pd-t\" data-utc=\"2026-10-23T21:00:00Z\" data-f=\"wt\">Fri 21:00 UTC</span> your time</span></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#\">+ Add to calendar</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"/series/f1/\">Weekend page →</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:group {\"className\":\"pd-sessions\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group pd-sessions\"><!-- wp:group {\"className\":\"pd-ses\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group pd-ses\"><!-- wp:paragraph -->\n<p><strong>Practice 1</strong><span class=\"pd-t\" data-utc=\"2026-10-23T17:30:00Z\" data-f=\"wt\">Fri 17:30 UTC</span><span class=\"pd-st\" data-pd-start=\"2026-10-23T17:30:00Z\" data-pd-end=\"2026-10-23T18:30:00Z\"></span></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"pd-ses\",\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group pd-ses\"><!-- wp:paragraph -->\n<p><strong>Practice 2</strong><span class=\"pd-t\" data-utc=\"2026-10-23T21:00:00Z\"