{
  "name": "motorsport",
  "version": "0.314.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/bundle-content.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "tsx scripts/bundle-content.mts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "indexnow:submit": "tsx scripts/submit-sitemap-to-indexnow.ts",
    "health:standings": "tsx scripts/health-standings.mts",
    "health:results": "tsx scripts/health-results.mts",
    "health:sessions": "tsx scripts/health-sessions.mts",
    "health:f1-schedule": "tsx scripts/health-f1-schedule.mts",
    "health": "tsx scripts/health-standings.mts && tsx scripts/health-results.mts && tsx scripts/health-sessions.mts",
    "assistant:eval": "tsx scripts/assistant-eval.mts",
    "prepare": "husky",
    "cf:build": "opennextjs-cloudflare build",
    "cf:populate": "opennextjs-cloudflare populateCache remote --cacheChunkSize 5",
    "cf:populate:testing": "opennextjs-cloudflare populateCache remote -c wrangler.testing.jsonc --cacheChunkSize 5",
    "deploy": "npm run cf:build && wrangler deploy && npm run cf:populate",
    "deploy:testing": "npm run cf:build && wrangler deploy -c wrangler.testing.jsonc && npm run cf:populate:testing",
    "deploy:cf:testing": "wrangler deploy -c wrangler.testing.jsonc && (npm run cf:populate:testing || echo \"populate skipped, non-fatal: cache warms on first visit\")",
    "deploy:cf": "wrangler deploy && npm run cf:populate",
    "cf:populate:paris": "opennextjs-cloudflare populateCache remote -c wrangler.paris.jsonc --cacheChunkSize 5",
    "deploy:paris": "npm run cf:build && wrangler deploy -c wrangler.paris.jsonc && npm run cf:populate:paris",
    "deploy:cf:paris": "wrangler deploy -c wrangler.paris.jsonc && (npm run cf:populate:paris || echo \"populate skipped, non-fatal: cache warms on first visit\")",
    "cf:populate:panagiotis": "opennextjs-cloudflare populateCache remote -c wrangler.panagiotis.jsonc --cacheChunkSize 5",
    "deploy:panagiotis": "npm run cf:build && wrangler deploy -c wrangler.panagiotis.jsonc && npm run cf:populate:panagiotis",
    "deploy:cf:panagiotis": "wrangler deploy -c wrangler.panagiotis.jsonc && (npm run cf:populate:panagiotis || echo \"populate skipped, non-fatal: cache warms on first visit\")",
    "secrets:sync": "tsx --env-file=.env.production.local scripts/sync-worker-secrets.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/opendyslexic": "^5.3.0",
    "@google-analytics/data": "^6.1.0",
    "@googleapis/searchconsole": "^6.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/leaflet": "^1.9.21",
    "@upstash/redis": "^1.38.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "domhandler": "^5.0.3",
    "fast-xml-parser": "^5.8.0",
    "gray-matter": "^4.0.3",
    "ical.js": "^2.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "^16.2.12",
    "node-ical": "^0.26.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-rehype": "11.1.2",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^0.3.2",
    "three": "^0.185.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@types/web-push": "^3.6.4",
    "esbuild-wasm": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "wrangler": "^4.114.0"
  }
}
