{
  // TESTING worker — serves testing.paddock-tracker.com from the `testing`
  // branch so contributor work never has to touch main/prod.
  //
  // Deploy by hand:  npm run deploy:testing   (build + deploy + POPULATE)
  // Workers Builds:  Production branch  `testing`
  //                  Build command      `npm run cf:build`
  //                  Deploy command     `npm run deploy:cf:testing`
  //                  Build variables    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
  //                                     NEXT_PUBLIC_ASSISTANT_ENABLED=1, DATA_SOURCE=db
  //
  // ⚠ The build command must be the OPENNEXT build, not `npm run build`. Plain
  // `next build` emits only `.next/`, while `worker.ts` imports
  // `./.open-next/worker.js` — so wrangler deploy then fails on a missing entry
  // (Workers Builds' first real run, 2026-07-27, failed exactly this way).
  // Cloudflare will also nag that the root wrangler.jsonc's `name` does not match
  // this Worker: ignore it. The root config is PRODUCTION on purpose; the `-c`
  // flag in the deploy command is what selects this one.
  //
  // ⚠ The deploy command MUST carry `-c wrangler.testing.jsonc`. Workers Builds
  // defaults to a bare `npx wrangler deploy`, which reads the repo-root
  // wrangler.jsonc — the PRODUCTION config (`name: motorsport`) — so a push to
  // `testing` would deploy over prod.
  // ⚠ The populate step is not optional: R2 cache keys are namespaced by
  // BUILD_ID, so every deploy orphans the warm cache and this worker (no traffic,
  // no crons) then serves cold renders indefinitely.
  // ⚠ Workers Builds keeps BUILD variables separate from runtime vars, and Next
  // inlines NEXT_PUBLIC_* at build. Set as BUILD variables or the built worker
  // loses client-side Clerk, the assistant, and push subscribe:
  // NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, NEXT_PUBLIC_ASSISTANT_ENABLED=1,
  // NEXT_PUBLIC_VAPID_PUBLIC_KEY, DATA_SOURCE=db.
  //
  // Secrets are per-worker: `wrangler secret put <KEY> --name motorsport-testing`.
  //
  // Differences from prod (wrangler.jsonc), each deliberate:
  //  - NO `triggers` block: the crons (notify, publish-posts, …) must run ONCE,
  //    on prod. A second worker firing them would double-send pushes and
  //    double-publish posts against the same prod KV/Supabase.
  //  - Route is the testing subdomain only (its DNS record already exists,
  //    Cloudflare-proxied — verified 2026-07-27, it was 402ing at dead Vercel).
  //  - Same R2 bucket but under the `testing-cache` prefix so the two workers'
  //    ISR entries can never collide.
  //  - WORKER_SELF_REFERENCE points at THIS worker (revalidation calls back in).
  //  - DATA_SOURCE=db as on prod: testing reads the same seeded KV/Supabase
  //    snapshots and never fetches (or writes) upstream data.
  //    ⚠ App mutations (bets, threads, blog admin) DO hit the same prod
  //    Supabase — fine for a two-person team, but know it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "motorsport-testing",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "testing.paddock-tracker.com/*", "zone_name": "paddock-tracker.com" }
  ],
  "vars": {
    "DATA_SOURCE": "db",
    "NEXT_INC_CACHE_R2_PREFIX": "testing-cache"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "paddock-inc-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "motorsport-testing"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
