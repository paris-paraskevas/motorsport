{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "motorsport",
  // nodejs_compat is REQUIRED for the Next runtime + this app's Node-heavy deps
  // (node-ical, web-push). compatibility_date must be >= 2024-09-23 for Next on
  // Workers; using a recent date to get the widest Node compat surface.
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // PF2 PR C (2026-10-06, the operator's "front cache on prod"): Workers Cache keeps a copy of every cacheable
  // response in front of this Worker, keyed by path and query (not the hostname) and governed by the response's own
  // Cache-Control; a hit runs no code and bills no CPU. The rules its key needs run in worker.ts (lib/cache-headers.ts):
  // the dev. host private, no header means no-store, a STALE answer never stored, every cacheable response tagged
  // path:<pathname>,site, every revalidation purging its tags. The www and http 301s sit in front of it as zone rules.
  // Rollback: remove this line, one deploy. Proven on the testing Worker first (docs/pull-requests.md #1136).
  "cache": { "enabled": true },
  // Serve the live domain from this Worker (routes intercept before the old
  // Vercel origin). The zone's DNS is already on Cloudflare, proxied.
  // `dev.*` is the admin entry point. Its DNS record is already proxied through
  // Cloudflare (verified 2026-07-27: `Server: cloudflare` + `CF-RAY`, forwarding
  // to the disabled Vercel project → 402), so adding the route here is all that's
  // needed to intercept it — no DNS change.
  "routes": [
    { "pattern": "paddock-tracker.com/*", "zone_name": "paddock-tracker.com" },
    { "pattern": "www.paddock-tracker.com/*", "zone_name": "paddock-tracker.com" },
    { "pattern": "dev.paddock-tracker.com/*", "zone_name": "paddock-tracker.com" }
  ],
  // Cron Triggers — each fires scheduled() in worker.ts, mapped by cron string
  // to the /api/cron/* route(s) in CRON_JOBS. notify runs every minute for tight
  // session-relative reminders.
  "triggers": {
    "crons": [
      "* * * * *",
      "*/10 * * * *",
      "*/15 * * * *",
      "*/30 * * * *",
      "7,22,37,52 * * * *",
      "0 * * * *",
      "47 */3 * * *",
      "17 */6 * * *",
      "29 */12 * * *",
      "41 4 * * *",
      "19 5 * * *",
      "0 8 * * 1",
      "20 6 * * 2"
    ]
  },
  // DB-as-single-source-of-truth. The community data APIs block Cloudflare's
  // shared egress IPs, so the render path must never call them: with this set the
  // standings/results loaders read the KV + Supabase `source_snapshot` tiers only
  // (see `isDbReadOnly` in lib/source-snapshot.ts). The ONLY writer is
  // `scripts/warm-live-data.mts`, run from clean IPs by the warm-live-data GitHub
  // Action. Unset this and prod data goes non-deterministic again (a colo that
  // isn't blocked returns partial data and overwrites the good cache).
  "vars": {
    "DATA_SOURCE": "db",
    // Phase 0 of the designer plan: the F1 standings tab reads the `standing_current`
    // rows and falls back to the payload when they are empty. In this file rather
    // than the dashboard because `wrangler deploy` (every merge) replaces dashboard
    // vars: the value the operator set by hand on 2026-09-07 would vanish otherwise.
    "DATA_TABLES": "on",
    // Phase 1: the ONLY config that says "production". `isProductionWorker()` in
    // lib/env.ts gates every design write; the preview configs must never carry it
    // (they share this database, so a design write from a preview edits the live site).
    "PADDOCK_ENV": "production",
    // PA A3: the sign-in pages' two public values (the Turnstile widget's site key and the Google client's id); the
    // secrets beside them (the widget's secret, the client's secret, the SMTP key) live in Supabase's auth config,
    // and the Worker's own secret key in `wrangler secret` under SUPABASE_SECRET_KEY.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFDKQWzpce8hsLMk",
    "GOOGLE_CLIENT_ID": "513497886552-3ho1glc0fbt6upu8vobi3d0r4rugkect.apps.googleusercontent.com"
  },
  // ISR page cache (see open-next.config.ts). Without these the adapter falls
  // back to its "dummy" cache and every request re-renders.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "paddock-inc-cache"
    },
    // The operator's photos (designer step 10, Assets): uploaded by
    // /api/admin/design/assets on production only, served by /media/<key> from
    // every Worker. Created by the operator on 2026-09-08.
    {
      "binding": "MEDIA",
      "bucket_name": "paddock-media"
    }
  ],
  // The DO queue that runs background revalidation of stale pages. `service`
  // MUST equal this worker's own `name` — the DO calls back in through it.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "motorsport"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  // Keep logs. Without this a production 500 leaves NO trace: the dashboard
  // shows nothing after the event and the exception is only visible if
  // `wrangler tail` happened to be running at the time. Sampling at 1 (keep
  // everything) because this site's request volume is nowhere near the point
  // where log ingestion is a cost concern. Invocation logs off (O6, 2026-10-10):
  // Cloudflare's automatic one-record-per-call log, 94% of it the page-tag cache
  // Durable Object's calls in a sample of `wrangler tail`; every line the code
  // writes, errors included, is still kept.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // Added in later steps (need Cloudflare account resources):
  //  - r2_buckets: NEXT_INC_CACHE_R2_BUCKET (ISR persistence)
  //  - services: WORKER_SELF_REFERENCE (cache revalidation)
  //  - images: IMAGES binding (next/image optimization)
  //  - triggers.crons (the 13 /api/cron/* jobs)
  //  - vars / secrets (Clerk, Supabase, KV_REST_API_*, VAPID, CRON_SECRET, Sentry)
}
