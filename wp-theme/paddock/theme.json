{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Ground", "color": "#f5f6f8" },
				{ "slug": "contrast", "name": "Ink", "color": "#0f1217" },
				{ "slug": "accent-1", "name": "Orange: now, next and the main action", "color": "#ff5b14" },
				{ "slug": "accent-2", "name": "Sunken", "color": "#eceef2" },
				{ "slug": "accent-3", "name": "Band", "color": "#0f1217" },
				{ "slug": "accent-4", "name": "Muted", "color": "#4b5361" },
				{ "slug": "accent-5", "name": "Surface", "color": "#ffffff" },
				{ "slug": "accent-6", "name": "Hairline", "color": "color-mix(in srgb, currentColor 20%, transparent)" },
				{ "slug": "pd-line", "name": "Line", "color": "#e2e5ea" },
				{ "slug": "pd-line-strong", "name": "Line, strong", "color": "#c4cad3" },
				{ "slug": "pd-live", "name": "Live", "color": "#d7262e" },
				{ "slug": "pd-on-colour", "name": "Ink on a series colour", "color": "#0f1217" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"name": "Archivo",
					"slug": "archivo",
					"fontFamily": "Archivo, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-latin.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-latin-ext.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{ "name": "Monospace", "slug": "fira-code", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.375rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem" },
				{ "slug": "xx-large", "name": "Huge", "size": "3rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|archivo",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"letterSpacing": "0",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": {
					"fontFamily": "var:preset|font-family|archivo",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1",
					"textTransform": "none"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "1.25rem" } },
			"h4": { "typography": { "fontSize": "1.0625rem" } },
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				":hover": { "color": { "text": "var:preset|color|accent-1" } }
			},
			"button": {
				"border": { "radius": "0" },
				"color": { "background": "var:preset|color|accent-1", "text": "var:preset|color|pd-on-colour" },
				"typography": { "fontWeight": "800", "fontSize": "0.9375rem" },
				":hover": { "color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "0.75rem" }
			}
		},
		"blocks": {
			"core/button": { "border": { "radius": "0" } },
			"core/image": { "border": { "radius": "0" } },
			"core/search": { "border": { "radius": "0" } },
			"core/table": { "typography": { "fontSize": "0.9375rem" } },
			"core/site-title": { "typography": { "fontSize": "1.0625rem", "fontWeight": "800", "letterSpacing": "-0.015em" } },
			"core/navigation": { "typography": { "fontSize": "0.875rem", "fontWeight": "600" } },
			"core/post-title": { "typography": { "fontWeight": "800" } }
		}
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page", "postTypes": [ "page" ] }
	]
}
